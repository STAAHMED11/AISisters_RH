# --- required ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=            # written by: python scripts/setup_agent.py
APP_PASSWORD=orvane             # recruiters' shared password: change it
SECRET_KEY=change-me            # long random string (openssl rand -hex 32)
PUBLIC_URL=http://localhost:3000   # in production: the real https URL (used in invitation links)

# --- models (defaults shown) ---
MODEL_SMART=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5

# --- triage and interviews (defaults shown) ---
# YES_THRESHOLD=0.70
# MAYBE_THRESHOLD=0.45
# INTERVIEW_VALID_DAYS=7
# AUTO_SEND_INVITES=0           1 = e-mail the link to pre-qualified candidates automatically (needs SMTP_HOST)

# --- e-mail: leave SMTP_HOST empty and sending is simulated ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=Recrutement Orvane <you@gmail.com>

# --- storage ---
# DATA_DIR=./data
# DB_JOURNAL=WAL                (Modal sets DELETE for its network volume)
